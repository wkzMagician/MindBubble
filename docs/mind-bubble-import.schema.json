{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindbubble.app/schemas/import/v1.json",
  "title": "MindBubble import batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "items"],
  "properties": {
    "format": { "const": "mind-bubble-import" },
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cursor": { "type": "string", "minLength": 1 },
        "nextCursor": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "appearanceFrequency": { "type": "integer", "minimum": 1, "maximum": 5 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
