schema_version: 4

app:
  name: mind_bubble
  package_name: mind-bubble
  organization: dev.mindbubble
  description: Calm cross-platform concept reminder application

platforms:
  android: true
  ios: false
  windows: true
  macos: true
  linux: true
  web: false

capabilities:
  settings:
    instances:
      default:
        implementation: shared_preferences
  autostart:
    instances:
      default:
        implementation: launch_at_startup
        platforms: [windows, macos, linux]

sources:
  capabilities: github
